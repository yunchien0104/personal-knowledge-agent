{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://personal-brain.local/contracts/job-payload.v1.schema.json",
  "title": "Personal Brain Job Payload v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "userId",
    "jobType",
    "idempotencyKey",
    "input"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "jobId": { "type": "string", "format": "uuid" },
    "userId": { "type": "string", "format": "uuid" },
    "jobType": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,63}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input": { "type": "object" }
  }
}
