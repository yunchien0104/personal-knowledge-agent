# Web: safe local placeholders only
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=local-publishable-key-placeholder

# Server/worker: never expose these values to browser code
SUPABASE_SERVICE_ROLE_KEY=local-service-role-key-placeholder
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
WORKER_ID=local-worker
JOB_POLL_INTERVAL_SECONDS=2
