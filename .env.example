# Web: safe local placeholders only
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional runtime overrides for server-only Next.js code and integration tests
SUPABASE_SERVER_URL=
SUPABASE_SERVER_PUBLISHABLE_KEY=

# Server/worker: never expose these values to browser code
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
WORKER_ID=
JOB_LEASE_SECONDS=
JOB_POLL_INTERVAL_SECONDS=
WORKER_CAPABILITY=
THREADS_FETCH_TIMEOUT_MS=
RESEARCH_SUGGESTIONS_ENABLED=
DEEP_RESEARCH_ENABLED=false
R2B_R2C_PROVIDER=openai-compatible
R2B_R2C_SERVICE_TIER=default
R2B_R2C_PROMPT_CACHE_MODE=explicit
R2B_R2C_API_BASE_URL=
R2B_R2C_API_KEY=
R2B_MODEL=
R2C_MODEL=
R2B_MAX_OUTPUT_TOKENS=8192
R2C_MAX_OUTPUT_TOKENS=8192
R2B_TIMEOUT_SECONDS=60
R2C_TIMEOUT_SECONDS=60
R2B_REASONING_EFFORT=low
R2C_REASONING_EFFORT=low
R2B_PRICING_VERIFIED=false
R2C_PRICING_VERIFIED=false
R2B_INPUT_COST_PER_MILLION_USD=
R2B_OUTPUT_COST_PER_MILLION_USD=
R2C_INPUT_COST_PER_MILLION_USD=
R2C_OUTPUT_COST_PER_MILLION_USD=

# Deep-only R2A/R2E/R2F accounting. Pricing must match RESEARCH_MODEL exactly.
# Legacy Research keeps its existing execution path and does not consume these values.
RESEARCH_MODEL=
DEEP_FINAL_PRICING_MODEL=
DEEP_FINAL_PRICING_VERIFIED=false
DEEP_FINAL_INPUT_COST_PER_MILLION_USD=
DEEP_FINAL_OUTPUT_COST_PER_MILLION_USD=
DEEP_FINAL_SERVICE_TIER=default
DEEP_FINAL_PROMPT_CACHE_MODE=explicit
DEEP_FINAL_REASONING_EFFORT=low
DEEP_FINAL_TIMEOUT_SECONDS=180
DEEP_FINAL_MAX_CLAIMS=6
DEEP_R2A_MAX_INPUT_TOKENS=48000
DEEP_R2A_MAX_OUTPUT_TOKENS=16384
DEEP_R2E_MAX_INPUT_TOKENS=4000
DEEP_R2E_MAX_OUTPUT_TOKENS=4096
DEEP_R2F_REPAIR_MAX_INPUT_TOKENS=64000
DEEP_R2F_REPAIR_MAX_OUTPUT_TOKENS=16384
DEEP_R2F_VERIFY_MAX_INPUT_TOKENS=4000
DEEP_R2F_VERIFY_MAX_OUTPUT_TOKENS=4096

# Server-only configurable Structured Output model (Mocked in tests)
SOURCE_NOTE_MODEL_MODE=
LLM_PROVIDER=
LLM_API_BASE_URL=
LLM_API_KEY=
SOURCE_NOTE_MODEL=
SOURCE_NOTE_MAX_INPUT_CHARS=
SOURCE_NOTE_MAX_OUTPUT_TOKENS=

OPENAI_API_KEY=
OPENAI_MODEL=

# Notes Inline AI. Provider selection is explicit; there is no automatic fallback.
# NOTES_AI_MODEL must be enabled for the configured server-side provider account.
NOTES_AI_PROVIDER=
NOTES_AI_MODEL=
NOTES_AI_TIMEOUT_MS=30000
GEMINI_API_KEY=
NOTES_AI_GEMINI_MODELS=

# Server-only URL-to-note Reel pipeline. The acquisition provider must be
# licensed for public Reel access; media hosts are an explicit SSRF allowlist.
REEL_ACQUISITION_PROVIDER=generic
REEL_ACQUISITION_API_URL=
REEL_ACQUISITION_API_KEY=
REEL_MEDIA_ALLOWED_HOSTS=
# Apify mode uses the official Reel Scraper and its stored downloadedVideo.
# Keep APIFY_API_TOKEN server-side; the actor id normally needs no override.
APIFY_API_TOKEN=
APIFY_REEL_ACTOR_ID=apify~instagram-reel-scraper
REEL_TRANSCRIPTION_MODEL=gpt-transcribe
REEL_VISION_MODEL=gpt-4.1-mini

# Server-only multilingual embedding provider. Kept separate from the Sol chat
# endpoint because Sol embedding capability has not been verified.
EMBEDDING_API_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODEL_VERSION=openai-v1-1536
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
